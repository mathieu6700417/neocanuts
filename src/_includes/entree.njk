{%- set d = entree.data -%}
<article class="entree" id="{{ d.slug }}" aria-labelledby="nom-{{ d.slug }}">
<p class="annee">
{%- if d.annee > 0 %}<time datetime="{{ d.annee | anneeIso }}">{{ d.date_affichee | insecables }}</time>{% else %}{{ d.date_affichee | insecables }}{% endif -%}
</p>
<h3 id="nom-{{ d.slug }}">{{ d.nom | insecables }}
{%- set dates = d.dates_affichees or (d.naissance | dates(d.mort)) -%}
{%- if dates %} <span class="dates">({{ dates | insecables }})</span>{% endif %}</h3>
<p class="notice">{{ d.notice | trim | insecables }}</p>
{%- if collections.pagesLongues | aUnePage(d.slug) %}
<a class="vers-chapitre" href="{{ ('/' + d.slug + '/') | url }}"><span class="visuellement-cache">Lire le chapitre : {{ d.oeuvre | insecables }}. </span><blockquote cite="{{ d.source_url }}">
{{ entree.content | safe }}</blockquote></a>
{%- else %}
<blockquote cite="{{ d.source_url }}">
{{ entree.content | safe }}</blockquote>
{%- endif %}
<p class="reference">{{ d.oeuvre | insecables }}{% if d.traduction %} — {{ d.traduction | insecables }}{% endif %}. <span class="theme">Thème : {{ themes[d.theme] }}</span></p>
{%- if d.original %}
<details class="original">
<summary>Texte original</summary>
<p lang="{{ d.langue }}"{% if d.langue == "he" %} dir="rtl"{% endif %}>{{ d.original | trim }}</p>
</details>
{%- endif %}
{%- if local and extraits[d.slug] %}
{%- set demande = extraits[d.slug] %}
{%- set dernier = demande.fil | last %}
<aside class="extrait-local" data-etat="{{ demande.etat }}" aria-label="Changement d'extrait">
<p class="note-tete">Nouvel extrait · {{ demande.etat }}</p>
<blockquote class="extrait-passage"><p>{{ demande.passage }}</p></blockquote>
<p class="tour tour-{{ 'claude' if dernier.auteur == 'Claude' else 'mathieu' }}"><b>{{ "Claude" if dernier.auteur == "Claude" else "Vous" }}{% if dernier.type == "précision" %} (précision){% endif %} :</b> {{ dernier.texte }}</p>
<p class="note-actions">
{%- if demande.etat == "sans extrait" %}<button type="button" data-action="precision-extrait" data-slug="{{ d.slug }}">Demander une précision</button> {% endif -%}
<button type="button" data-action="abandonner-extrait" data-slug="{{ d.slug }}">Abandonner la demande</button></p>
</aside>
{%- endif %}
<p class="liens">
{%- if d.texte_integral_url %}<a href="{{ d.texte_integral_url }}">Texte intégral</a> · {% endif -%}
{%- if d.original_url and d.original_url != d.source_url %}<a href="{{ d.original_url }}"{% if d.langue != "fr" %} hreflang="{{ d.langue }}"{% endif %}>Original</a> · {% endif -%}
<a href="{{ d.source_url }}">Source de l'extrait</a>, vérifiée le <time datetime="{{ d.verifie | dateIso }}">{{ d.verifie | dateFr }}</time></p>
</article>
